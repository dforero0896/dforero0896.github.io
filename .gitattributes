# Define standard eol format

# Web files
*.html text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# Data and config
*.json text eol=lf
*.yml text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf

# GitHub specific files
LICENCE text eol=lf

# General multimedia files
*.jpg binary
*.jpeg binary
*.gif binary
*.png binary
*.t3x binary
*.t3d binary
*.exe binary
*.data binary
*.ttf binary
*.eof binary
*.eot binary
*.swf binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.ogg binary
*.flv binary
